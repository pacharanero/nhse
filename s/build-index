#
# Regenerate fdp/index.json from fdp/entries/*.yaml and do a minimal schema
# check: required fields present, id matches filename, ids unique, date is
# ISO, tags present and slug-shaped, archive_url present, quote_verified
# present when quote is.
#
# GitHub Pages has no directory listing, so the client-side site needs an
# index telling it which entry files exist. This script is the only thing
# that should write fdp/index.json - never hand-edit it.
#
# Run after adding or editing any file in fdp/entries/:
#   s/build-index

import json
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
ENTRIES_DIR = ROOT / "fdp" / "entries"
INDEX_PATH = ROOT / "fdp" / "index.json"

REQUIRED = ["id", "date", "date_precision", "tags", "title", "summary", "source_url", "source_title", "archive_url"]
VALID_PRECISION = {"day", "month", "quarter"}
VALID_VERIFICATION = {"audio", "document", "secondary"}
ISO_DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
TAG_SLUG = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def main():
    errors = []
    entries = []
    seen_ids = set()

    files = sorted(ENTRIES_DIR.glob("*.yaml"))
    if not files:
        print(f"error: no entries in {ENTRIES_DIR}", file=sys.stderr)
        sys.exit(1)

    for path in files:
        expected_id = path.stem
        data = yaml.safe_load(path.read_text()) or {}

        for field in REQUIRED:
            if not data.get(field):
                errors.append(f"{path.name}: missing required field '{field}'")

        entry_id = data.get("id")
        if entry_id and entry_id != expected_id:
            errors.append(f"{path.name}: id '{entry_id}' does not match filename")
        if entry_id in seen_ids:
            errors.append(f"{path.name}: duplicate id '{entry_id}'")
        seen_ids.add(entry_id)

        date = data.get("date")
        if date and not ISO_DATE.match(str(date)):
            errors.append(f"{path.name}: date '{date}' is not ISO YYYY-MM-DD")

        precision = data.get("date_precision")
        if precision and precision not in VALID_PRECISION:
            errors.append(f"{path.name}: invalid date_precision '{precision}'")

        tags = data.get("tags")
        if tags is not None:
            if not isinstance(tags, list) or not tags:
                errors.append(f"{path.name}: 'tags' must be a non-empty list")
            else:
                for t in tags:
                    if not isinstance(t, str) or not TAG_SLUG.match(t):
                        errors.append(f"{path.name}: tag '{t}' is not a lowercase-hyphenated slug")
                if len(set(tags)) != len(tags):
                    errors.append(f"{path.name}: duplicate tag in {tags}")

        if data.get("quote") and not data.get("quote_verified"):
            errors.append(f"{path.name}: has 'quote' but no 'quote_verified'")
        if data.get("quote_verified") and data["quote_verified"] not in VALID_VERIFICATION:
            errors.append(f"{path.name}: invalid quote_verified '{data['quote_verified']}'")

        entries.append({
            "id": expected_id,
            "date": str(data.get("date")),
            "date_precision": precision,
            "tags": tags,
            "title": data.get("title"),
            "file": f"entries/{path.name}",
        })

    if errors:
        print("s/build-index: validation failed", file=sys.stderr)
        for e in errors:
            print(f"  {e}", file=sys.stderr)
        sys.exit(1)

    entries.sort(key=lambda e: (e["date"] or "", e["id"]))
    INDEX_PATH.write_text(json.dumps(entries, indent=2) + "\n")
    print(f"==> wrote {INDEX_PATH.relative_to(ROOT)} with {len(entries)} entries", file=sys.stderr)


if __name__ == "__main__":
    main()
