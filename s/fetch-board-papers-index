#
# Build an index of every NHS England board meeting's "agenda and papers"
# publication (plus its paired video/minutes/private-papers entries) into
# nhs-board-papers/manifest.tsv.
#
# NHS England's website is WordPress, and exposes a working REST API at
# /wp-json/wp/v2/. The "agenda and papers" pages (e.g. .../publication/
# nhs-england-public-board-meeting-agenda-and-papers-17-july-2025/) are a
# custom post type called "document" (rest_base "documents", labelled
# "Publication Containers" in /wp-json/wp/v2/types), and every one of
# interest carries the "Board meetings" category (id 141). Querying that
# category directly, paginated, gives a clean structured list back to
# 2014 in two requests - far more reliable than scraping the "previous
# meetings" listing page, which is paginated HTML and may not go back as
# far.
#
# Title formats have changed several times as the board itself changed
# shape (NHS England alone -> NHS England and NHS Improvement "meetings
# in common" after 2018 -> merged "NHS England public board meeting"
# after the 2022 legal merger -> a further title simplification in 2025),
# plus three other publication kinds that share the same category:
# "Video of the NHS England ... board meeting", "NHS England Board
# meeting minutes" (rare), and "Private Board Papers: <Month> <Year>"
# (retrospectively published private-session papers, batch-released long
# after the fact, month precision only, no paired video). This script
# classifies each by kind and extracts the meeting date from the title
# text itself (the thing that happened), not the WordPress publish date
# (when it was put online) - same "date the thing happened" rule as
# CONTRIBUTING.md's entry schema. A handful of early AGM agendas carry no
# day/month in their title at all; those fall back to the publish date
# with date_precision "unknown" so that imprecision stays visible rather
# than silently inventing a day.
#
# This only builds the index (meeting date, kind, title, link) - it does
# not fetch the underlying PDFs/pages, extract their item lists, or
# archive anything. That is a deliberately separate, selective step for
# whichever meetings turn out to matter to a specific research thread
# (e.g. FDP-relevant ones), the same division of labour already used
# between nhs-board-transcripts/ (fetch the whole corpus) and
# fdp/entries/ (extract dated facts from the parts that matter) - see
# `s/search` for finding which transcripts are worth that attention.
#
# Usage:
#   s/fetch-board-papers-index

import html
import json
import re
import sys
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT_DIR = ROOT / "nhs-board-papers"
MANIFEST = OUT_DIR / "manifest.tsv"

API_BASE = "https://www.england.nhs.uk/wp-json/wp/v2/documents"
BOARD_MEETING_CATEGORY = 141
PER_PAGE = 100

MONTHS = (
    "January|February|March|April|May|June|July|August|September|October|November|December"
)
DAY_MONTH_YEAR_RE = re.compile(rf"(\d{{1,2}})\s+({MONTHS})\s+(\d{{4}})")
MONTH_YEAR_RE = re.compile(rf"({MONTHS})\s+(\d{{4}})")
MONTH_NUM = {
    name: i + 1
    for i, name in enumerate(
        "January February March April May June July August September October November December".split()
    )
}

FIELDNAMES = ["meeting_date", "date_precision", "kind", "wp_id", "title", "link"]


def http_get_json(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": "nhse-research-archive/1 (contact: see repo)"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def fetch_all_documents():
    print(f"==> Querying board-meeting category (id {BOARD_MEETING_CATEGORY}) from the WP REST API", file=sys.stderr)
    items = []
    page = 1
    while True:
        url = (
            f"{API_BASE}?categories={BOARD_MEETING_CATEGORY}&per_page={PER_PAGE}&page={page}"
            "&orderby=date&order=asc&_fields=id,date,title,link"
        )
        batch = http_get_json(url)
        if not batch:
            break
        items.extend(batch)
        if len(batch) < PER_PAGE:
            break
        page += 1
    print(f"==> {len(items)} publications found", file=sys.stderr)
    return items


def classify_kind(title):
    t = title.lower()
    if t.startswith("private board papers"):
        return "private_papers"
    if t.startswith("video") or t.startswith("videos"):
        return "video"
    if "minutes" in t:
        return "minutes"
    if "annual general meeting" in t or re.search(r"\bagm\b", t):
        return "agm"
    if "agenda and papers" in t or "agenda & papers" in t or "agenda papers" in t or "board meeting papers" in t or "board papers for" in t:
        return "agenda_papers"
    return "other"


def extract_date(title, publish_date):
    m = DAY_MONTH_YEAR_RE.search(title)
    if m:
        day, month_name, year = m.groups()
        return f"{int(year):04d}-{MONTH_NUM[month_name]:02d}-{int(day):02d}", "day"

    m = MONTH_YEAR_RE.search(title)
    if m:
        month_name, year = m.groups()
        return f"{int(year):04d}-{MONTH_NUM[month_name]:02d}-01", "month"

    # No date in the title at all (a handful of early AGM agendas) - fall
    # back to the WordPress publish date rather than guessing, and mark
    # the imprecision explicitly so it is never mistaken for a confirmed
    # meeting date.
    return publish_date[:10], "unknown"


def build_rows(documents):
    rows = []
    for doc in documents:
        raw_title = doc["title"]["rendered"]
        title = html.unescape(raw_title)
        kind = classify_kind(title)
        meeting_date, precision = extract_date(title, doc["date"])
        rows.append(
            {
                "meeting_date": meeting_date,
                "date_precision": precision,
                "kind": kind,
                "wp_id": doc["id"],
                "title": title,
                "link": doc["link"],
            }
        )
    rows.sort(key=lambda r: (r["meeting_date"], r["kind"], r["wp_id"]))
    return rows


def write_manifest(rows):
    OUT_DIR.mkdir(exist_ok=True)
    with open(MANIFEST, "w", newline="") as f:
        f.write("\t".join(FIELDNAMES) + "\n")
        for row in rows:
            f.write("\t".join(str(row[field]) for field in FIELDNAMES) + "\n")


def main():
    documents = fetch_all_documents()
    rows = build_rows(documents)
    write_manifest(rows)
    print(f"==> Wrote {MANIFEST.relative_to(ROOT)} with {len(rows)} publications", file=sys.stderr)

    by_kind = {}
    for row in rows:
        by_kind[row["kind"]] = by_kind.get(row["kind"], 0) + 1
    for kind, count in sorted(by_kind.items()):
        print(f"    {kind}: {count}", file=sys.stderr)

    unknown = [r for r in rows if r["date_precision"] == "unknown"]
    if unknown:
        print(f"==> {len(unknown)} publication(s) had no date in their title (used publish date instead):", file=sys.stderr)
        for row in unknown:
            print(f"    {row['meeting_date']}  {row['title']}", file=sys.stderr)


if __name__ == "__main__":
    main()
